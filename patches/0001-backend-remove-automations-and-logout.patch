+    channel = _ch(
+        bus,
+        session_manager=_seed_session(tmp_path),
+        workspace_path=tmp_path,
+        port=_free_port(),
+    )
+    first = asyncio.create_task(
+        _webui_mutate(
+            channel,
+            "skill.install",
+            {"source": "acme/agent-skills", "skill": "react-testing"},
