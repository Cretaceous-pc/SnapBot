+def _trusted_proxy_config(
+    cidrs: list[str] | None = None,
+    *,
+    assertion_header: str = "Cf-Access-Jwt-Assertion",
+) -> dict[str, Any]:
+    return {
+        "trustedProxyAuth": {
+            "trustedPeerCidrs": cidrs or ["127.0.0.1/32"],
+            "assertionHeader": assertion_header,
+        }
+    }
